+/*
+ * cepheus v20: panic-time console-ring dump across the top of the screen.
+ * The persistent ring (bsd/dev/sweet_ufs.c) already holds every console
+ * byte via _cnputs; on panic the last lines are painted over the first
+ * screen rows (red banner on row 0) so a single photo captures the full
+ * failure scene, USB-independent. Needs no locks, no allocation, no
+ * scrolling state of its own: pmap and the framebuffer mapping are alive
+ * in panic context. Later panic text continues below the dump.
+ */
+#define SWEET_PANIC_ROWS 50
+#define SWEET_PANIC_BUF  (SWEET_PANIC_ROWS * 96)
+
+extern uint64_t sweet_log_position(void);
+extern uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
+
+void
+sweet_panic_fb_dump(void)
+{
+	static char dumpbuf[SWEET_PANIC_BUF];
+	static int dump_done;
+	uint32_t n, lines_total, skip, i, col, row;
+
+	if (dump_done || !fbcon_base || fbcon_rows < SWEET_PANIC_ROWS + 2) {
+		return;
+	}
+	dump_done = 1;
+
+	uint64_t pos = sweet_log_position();
+	uint64_t want = (uint64_t)sizeof(dumpbuf);
+	if (pos < want) {
+		want = pos;
+	}
+	pos -= want;
+	n = sweet_log_copy(&pos, dumpbuf, (uint32_t)want);
+
+	/* banner: one full red row so the dump is unmistakable in a photo */
+	for (uint32_t y = 0; y < 16 * FBCON_SCALE; y++) {
+		volatile uint32_t *line = fbcon_base + y * (fbcon_stride / 4);
+		for (uint32_t x = 0; x < fbcon_width; x++) {
+			line[x] = 0xffcc0000u;
+		}
+	}
+
+	/* start at the first line of the last SWEET_PANIC_ROWS lines */
+	lines_total = 0;
+	for (i = 0; i < n; i++) {
+		if (dumpbuf[i] == '\n') {
+			lines_total++;
+		}
+	}
+	skip = lines_total > SWEET_PANIC_ROWS ? lines_total - SWEET_PANIC_ROWS : 0;
+	i = 0;
+	while (skip && i < n) {
+		if (dumpbuf[i++] == '\n') {
+			skip--;
+		}
+	}
+	col = 0;
+	row = 1;
+	for (; i < n && row <= SWEET_PANIC_ROWS; i++) {
+		char ch = dumpbuf[i];
+		if (ch == '\n') {
+			row++;
+			col = 0;
+			continue;
+		}
+		if (ch == '\r') {
+			col = 0;
+			continue;
+		}
+		if (ch == '\t') {
+			col = (col + 8) & ~7u;
+		} else if ((unsigned char)ch >= 32 && (unsigned char)ch < 127) {
+			if (col >= fbcon_cols) {
+				row++;
+				col = 0;
+				if (row > SWEET_PANIC_ROWS) {
+					break;
+				}
+			}
+			fbcon_draw_char(col, row, (uint8_t)ch, FBCON_FG, FBCON_BG);
+			col++;
+		}
+	}
+	/* steer any later panic text below the dump, on a cleared row */
+	fbcon_row = SWEET_PANIC_ROWS + 1;
+	fbcon_col = 0;
+	fbcon_clear_row(fbcon_row);
+	__asm__ volatile("dsb sy" ::: "memory");
+}
