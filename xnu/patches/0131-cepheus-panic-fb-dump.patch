+/* Draw one 8x16 glyph (scaled) at a console cell. Panic context safe:
+ * pure framebuffer stores, no locks and no allocation. */
+static void
+fbcon_draw_char(uint32_t col, uint32_t row, uint8_t c, uint32_t fg, uint32_t bg)
+{
+	const unsigned char *glyph = iso_font + c * 16;
+	uint32_t x0 = col * 8 * FBCON_SCALE, y0 = row * 16 * FBCON_SCALE;
+	for (uint32_t gy = 0; gy < 16; gy++) {
+		for (uint32_t sy = 0; sy < FBCON_SCALE; sy++) {
+			volatile uint32_t *line = fbcon_base + (y0 + gy * FBCON_SCALE + sy) * (fbcon_stride / 4) + x0;
+			for (uint32_t gx = 0; gx < 8; gx++) {
+				uint32_t px = (glyph[gy] & (1u << gx)) ? fg : bg;
+				for (uint32_t sx = 0; sx < FBCON_SCALE; sx++) {
+					line[gx * FBCON_SCALE + sx] = px;
+				}
+			}
+		}
+	}
+}
